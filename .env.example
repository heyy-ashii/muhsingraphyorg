# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API. The anon key is safe for the browser; RLS enforces
# read-only access to published artworks and write access for the curator.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Storage bucket that holds artwork photography (created by supabase/schema.sql)
NEXT_PUBLIC_SUPABASE_BUCKET=artwork-media

# ── Site ────────────────────────────────────────────────────────────────────
# Used to build absolute artwork URLs inside WhatsApp enquiry messages.
NEXT_PUBLIC_SITE_URL=https://muhsingraphy.com
