# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API. The publishable key is safe for the browser; RLS
# enforces read-only access to published artworks and write access for the
# curator. The classic NEXT_PUBLIC_SUPABASE_ANON_KEY name is also accepted as a
# fallback for both the browser and server readers.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Used by @supabase/server's core primitives. Server-only — never exposed to the
# browser (see src/lib/supabase/env.ts). Grants the admin client RLS bypass.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# Optional. JWT verification derives the JWKS from SUPABASE_URL automatically;
# set one of these only if you need to pin keys or use a custom issuer.
# SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Storage bucket that holds artwork photography (created by supabase/schema.sql)
NEXT_PUBLIC_SUPABASE_BUCKET=artwork-media

# ── Site ────────────────────────────────────────────────────────────────────
# Used to build absolute artwork URLs inside WhatsApp enquiry messages.
NEXT_PUBLIC_SITE_URL=https://muhsingraphy.com
